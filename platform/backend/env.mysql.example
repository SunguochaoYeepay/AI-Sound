# AI-Sound MySQL本地开发环境配置

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ai_sound_user
MYSQL_PASSWORD=ai_sound_password
MYSQL_DATABASE=ai_sound
MYSQL_CHARSET=utf8mb4

# 数据库连接URL
DATABASE_URL=mysql+pymysql://ai_sound_user:ai_sound_password@localhost:3306/ai_sound?charset=utf8mb4

# AI服务配置
MEGATTS3_URL=http://localhost:7929
TANGOFLUX_URL=http://localhost:7930
SONGGENERATION_URL=http://localhost:7862
OLLAMA_URL=http://localhost:11434

# 文件路径配置
AUDIO_DIR=./data/audio
UPLOADS_DIR=./data/uploads
VOICE_PROFILES_DIR=./data/voice_profiles
BACKUP_DIR=./data/backups

# 开发模式配置
DEBUG=true
LOCAL_DEV=true
ECHO_SQL=false

# 日志配置
LOG_LEVEL=INFO

# Redis配置
REDIS_URL=redis://localhost:6379

# 安全配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
